---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'ai-natch: 現場でAIエージェントを動かすための実践ブログ' } = Astro.props;
const siteTitle = 'ai-natch Blog';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | {siteTitle}</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={import.meta.env.BASE_URL}>ai-natch<span>.blog</span></a>
      <nav>
        <a href={`${import.meta.env.BASE_URL}blog/`}>記事一覧</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} ai-natch</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #0b0d10;
    --fg: #e8ecf1;
    --muted: #9aa4b2;
    --accent: #5eead4;
    --card: #14181d;
    --border: #232830;
    font-family: 'Helvetica Neue', 'Hiragino Kaku Gothic ProN', 'Hiragino Sans', Meiryo, sans-serif;
  }

  @media (prefers-color-scheme: light) {
    :root {
      --bg: #f7f8fa;
      --fg: #14181d;
      --muted: #5a6472;
      --accent: #0f766e;
      --card: #ffffff;
      --border: #e2e5ea;
    }
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    line-height: 1.7;
  }

  a {
    color: var(--accent);
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border);
    max-width: 760px;
    margin: 0 auto;
  }

  .brand {
    font-weight: 700;
    font-size: 1.25rem;
    text-decoration: none;
    color: var(--fg);
  }

  .brand span {
    color: var(--muted);
    font-weight: 400;
  }

  .site-header nav a {
    text-decoration: none;
    color: var(--fg);
    font-size: 0.95rem;
  }

  main {
    max-width: 760px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .site-footer {
    text-align: center;
    color: var(--muted);
    font-size: 0.85rem;
    padding: 2rem 0 3rem;
  }
</style>
